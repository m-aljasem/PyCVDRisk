    family-names: AlJasem
    email: mohamad@aljasem.eu.org
version: 2.0.0
date-released: 2026-11-02
repository-code: "https://github.com/m-aljasem/PyCVDRisk"
url: "https://pycvdrisk.aljasem.eu.org"
license:
  - MIT
  - LGPL-3.0-or-later
keywords:
  - cardiovascular disease
  - risk prediction
  - epidemiology
  - SCORE2
  - PREVENT
  - QRISK3
  - Framingham
  - Python
